# config/: whitelist model. Ignore everything by default so tool-generated
# directories (which may contain secrets) are never committed by accident;
# then explicitly allow only the configs we actually track.
#
# Policy / how to track a new config:
#   - Directory: add  !config/<name>/   (keep the trailing slash)
#   - Single file: add !config/<file>   (no trailing slash, e.g. starship.toml)
#   - Keep the allow-list below in alphabetical order.
#   - To re-ignore a path inside an allowed dir, add it under
#     "Inner ignores within allowed directories" below (e.g. config/gh/hosts.yml).
config/*
!config/bat/
!config/fastfetch/
!config/fsh/
!config/gh/
!config/ghostty/
!config/glow/
!config/k9s/
!config/lazygit/
!config/mise/
!config/nvim/
!config/sheldon/
!config/zsh/
!config/starship.toml
!config/starship_sub.toml
# Inner ignores within allowed directories (preserve previous behavior)
config/gh/hosts.yml

# claudecode/rules/: whitelist model, same reason as config/ above. Everything
# under ~/.claude/rules/ loads into every Claude Code session, and other repos
# link their own rules in there, so a file that belongs to another repo must
# never be committed here by accident. Track a new rule explicitly:
#   !claudecode/rules/<name>.md
claudecode/rules/*
!claudecode/rules/environment.md
!claudecode/rules/latency.md
!claudecode/rules/pull-requests.md
!claudecode/rules/writing.md

# mysqlsh
mysqlsh/*
!mysqlsh/options.json
!mysqlsh/prompt.json
.zcompdump*
# Wordcode caches built at shell startup (.zshrc compiles itself; see the tail
# of .zshrc). Land next to $ZDOTDIR, which is $HOME normally but the repo root
# in CI and in the zsh loading test.
.zshrc.zwc
.zshrc.new.zwc

# local-only (machine-specific / editor state)
.vim/.netrwhist
.vim/undodir/
.zshrc.local

**/.claude/settings.local.json

**/.claude/.cc-writes/

# Claude Code stores its git worktrees here. They are checkouts of this repo,
# so leaving them untracked makes `git status` dirty in the primary checkout,
# which the startup sync reminder then nags about and `git add -A` sweeps in.
**/.claude/worktrees/
