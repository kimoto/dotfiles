{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "400000"
  },
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(security export:*)",
      "Bash(/usr/bin/security find-generic-password:*)",
      "Bash(/usr/bin/security find-internet-password:*)",
      "Bash(/usr/bin/security dump-keychain:*)",
      "Bash(/usr/bin/security export:*)",
      "Bash(command security find-generic-password:*)",
      "Bash(command security find-internet-password:*)",
      "Bash(command security dump-keychain:*)",
      "Bash(command security export:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-track.sh\" ] || bash \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-track.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" SessionStart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_idle_recap.sh\" ] || \"$HOME/bin/claude_idle_recap.sh\" check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_handoff.sh\" ] || \"$HOME/bin/claude_handoff.sh\" start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-cleanup.sh\" ] || bash \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-cleanup.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" SessionEnd"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_handoff.sh\" ] || \"$HOME/bin/claude_handoff.sh\" end"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" Stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_idle_recap.sh\" ] || \"$HOME/bin/claude_idle_recap.sh\" record"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_idle_recap.sh\" ] || \"$HOME/bin/claude_idle_recap.sh\" check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_context_check.sh\" ] || \"$HOME/bin/claude_context_check.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/check_private_terms.sh\" ] || \"$HOME/bin/check_private_terms.sh\" claude-hook",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" PreToolUse"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_commit_secret_scan.sh\" ] || \"$HOME/bin/claude_commit_secret_scan.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_public_privacy_check.sh\" ] || \"$HOME/bin/claude_public_privacy_check.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_review_gate.sh\" ] || \"$HOME/bin/claude_review_gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" PostToolUse"
          }
        ]
      },
      {
        "matcher": "EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_tmux_hunk.sh\" ] || \"$HOME/bin/claude_tmux_hunk.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_pr_description_reminder.sh\" ] || \"$HOME/bin/claude_pr_description_reminder.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" ] || \"$HOME/.config/tmux-agent-status/scripts/hook.sh\" Notification"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/claude_tmux_hunk.sh\" ] || \"$HOME/bin/claude_tmux_hunk.sh\""
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) read -r _ cols < <(stty size 2>/dev/null </dev/tty) || cols=;; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); best=; bestk=-1; for d in \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/; do v=${d%/}; v=${v##*/}; case \"$v\" in \"\"|*[!0-9.]*) continue;; esac; IFS=. read -r a b c _ <<<\"$v\"; k=$(( ${a:-0}*1000000 + ${b:-0}*1000 + ${c:-0} )); if (( k > bestk )); then bestk=$k; best=$d; fi; done; [ -n \"$best\" ] || exit 0; bun=$(command -v bun) || bun=$HOME/.local/share/mise/installs/bun/latest/bin/bun; exec \"$bun\" --env-file /dev/null \"${best}src/index.ts\"'",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "figma@synced": false,
    "engineering@synced": false,
    "brightdata-plugin@synced": false,
    "codex@openai-codex": true,
    "data@synced": false,
    "productivity@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "Japanese",
  "autoCompactWindow": 500000,
  "advisorModel": "fable",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Repository visibility**: PUBLIC — kimoto/dotfiles (github.com, via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Default / protected branches**: `main` (default, protected via active ruleset) — kimoto/dotfiles",
      "**Source control**: The trusted repo (kimoto/dotfiles, github.com/kimoto/dotfiles) and its remote(s) only (no additional orgs configured)",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal dotfiles / hobby systems management (this repo is a public dotfiles configuration project)",
      "**Trusted repo**: kimoto/dotfiles (git repository at ~/ghq/github.com/kimoto/dotfiles, remote ssh://github.com/kimoto/dotfiles.git) — PUBLIC: only this repo's own work belongs here; confidential material and secrets must never be committed or pushed regardless of visibility"
    ]
  }
}
