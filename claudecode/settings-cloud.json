{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "autoCompactWindow": 500000,
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Edit(//**/claudecode/rules/**)",
      "Edit(//**/claudecode/rules-cloud/**)",
      "Edit(//**/claudecode/settings-cloud.json)",
      "Edit(~/.claude/rules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ \"$(git -C \"$d\" branch --show-current 2>/dev/null)\" = main ] && timeout 10 git -C \"$d\" pull -q --ff-only >/dev/null 2>&1; [ ! -x \"$d/bin/link_claude_dir.sh\" ] || \"$d/bin/link_claude_dir.sh\" --cloud >/dev/null 2>&1; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_context_check.sh\" ] || \"$d/bin/claude_context_check.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
