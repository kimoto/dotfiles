{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Japanese",
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "400000"
  },
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Edit(//**/claudecode/rules/**)",
      "Edit(//**/claudecode/rules-cloud/**)",
      "Edit(//**/claudecode/settings-cloud.json)",
      "Edit(~/.claude/rules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/refresh_cloud_session.sh\" ] || \"$d/bin/refresh_cloud_session.sh\" >/dev/null 2>&1; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_context_check.sh\" ] || \"$d/bin/claude_context_check.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_commit_secret_scan.sh\" ] || \"$d/bin/claude_commit_secret_scan.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_review_gate.sh\" ] || \"$d/bin/claude_review_gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_pr_description_reminder.sh\" ] || \"$d/bin/claude_pr_description_reminder.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(dirname \"$(dirname \"$(readlink -f ~/.claude/settings.json)\")\"); [ ! -x \"$d/bin/claude_review_gate.sh\" ] || \"$d/bin/claude_review_gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
