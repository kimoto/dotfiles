# Install:
# -------------------------------------------------------------------------
# $ wget -O- https://raw.githubusercontent.com/kimoto/dotfiles/main/README | sh
# -------------------------------------------------------------------------
#
cd $HOME
# A fresh Ubuntu has no git; mkworld installs the rest it lacks.
if ! command -v git >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update && sudo apt-get install -y git
fi
git clone --recursive https://github.com/kimoto/dotfiles.git
# Start from the last commit a full bootstrap passed on, not whatever main
# holds right now. main stays checked out, so later syncs move it forward.
git -C dotfiles reset --hard origin/stable || echo "no stable ref yet; using main"
./dotfiles/bin/mkworld.sh
