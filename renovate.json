{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "One PR a month carrying every update, majors included, and no automerge: a person reads each bump.",
    "A release ages 7 days before it is proposed, so a freshly published (possibly compromised) version is not pulled in at once."
  ],
  "extends": [
    "config:recommended",
    "schedule:monthly"
  ],
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^bin/install_check_tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=\"\\$\\{[A-Z_]+:-(?<currentValue>[^}]+)\\}\""
      ],
      "description": "mise itself, which bin/install_check_tools.sh downloads before mise.toml can be read.",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^bin/setup_homebrew\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n[A-Z_]+=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "description": "The Homebrew installer, which has no releases: pinned to a commit on its default branch, aged by the commit date."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/sheldon/plugins\\.toml$/"
      ],
      "matchStrings": [
        "github = ['\"](?<depName>[^'\"]+)['\"]\\nrev = '(?<currentDigest>[0-9a-f]{40})' # (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-digest",
      "description": "zsh plugins, pinned to a commit on the branch the trailing comment names. github-digest, not git-refs: it dates each commit, so minimumReleaseAge applies (measured from the commit date, not from when it reached the branch)."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tmux-plugins\\.lock$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w.-]+/[\\w.-]+) (?<currentValue>\\S+) (?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "description": "tmux plugins, same pinning as the zsh plugins above."
    }
  ],
  "packageRules": [
    {
      "description": "Commit types must pass bin/check_commit_msgs_range.sh.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Biome tags each release as @biomejs/biome@X.Y.Z, alongside tags for its other packages.",
      "matchDepNames": [
        "aqua:biomejs/biome"
      ],
      "extractVersion": "^@biomejs/biome@(?<version>.+)$"
    }
  ],
  "separateMajorMinor": false
}
